# ===========================================
# MockForge Frontend Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env file to Git!

# ===========================================
# API Configuration
# ===========================================
# Your deployed backend URL (Vercel)
# For local development: http://localhost:5000/api
# For production: https://your-backend.vercel.app/api
VITE_API_URL=http://localhost:5000/api

# ===========================================
# Footer & Credits Configuration
# ===========================================
# All footer fields are optional
# Leave empty or set to "none" to hide that field
# Set actual values to show them in the footer

# Company/Brand Information
VITE_FOOTER_COMPANY_NAME=MockForge
VITE_FOOTER_TAGLINE=Professional Portfolio Mockup Studio
VITE_FOOTER_DESCRIPTION=Create stunning portfolio mockups with our advanced design editor. Professional device mockups, smart backgrounds, and instant export.

# Contact Information (leave empty to hide)
VITE_FOOTER_EMAIL=
VITE_FOOTER_PHONE=
VITE_FOOTER_ADDRESS=

# Social Media Links (leave empty to hide)
VITE_FOOTER_GITHUB=
VITE_FOOTER_LINKEDIN=
VITE_FOOTER_TWITTER=
VITE_FOOTER_INSTAGRAM=
VITE_FOOTER_YOUTUBE=
VITE_FOOTER_PORTFOLIO=
VITE_FOOTER_WEBSITE=

# Creator/Developer Information (leave empty to hide)
VITE_FOOTER_CREATOR_NAME=
VITE_FOOTER_CREATOR_ROLE=
VITE_FOOTER_CREATOR_PORTFOLIO=

# Legal Pages (leave empty to hide)
VITE_FOOTER_PRIVACY_POLICY=
VITE_FOOTER_TERMS_OF_SERVICE=
VITE_FOOTER_COOKIE_POLICY=

# Additional Links (leave empty to hide)
VITE_FOOTER_BLOG=
VITE_FOOTER_CAREERS=
VITE_FOOTER_SUPPORT=
VITE_FOOTER_DOCUMENTATION=

# Copyright (leave empty for default: © 2024 Company Name)
VITE_FOOTER_COPYRIGHT_TEXT=

# Show "Built with" message (true/false)
VITE_FOOTER_SHOW_BUILT_WITH=true
