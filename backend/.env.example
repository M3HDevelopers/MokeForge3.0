# ===========================================
# MockForge Backend Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env file to Git!

# Server Configuration
PORT=5000
NODE_ENV=development

# ===========================================
# MongoDB Configuration
# ===========================================
# Get from MongoDB Atlas:
# 1. Go to https://www.mongodb.com/cloud/atlas
# 2. Create free cluster
# 3. Get connection string
# 4. Replace <password> with your database password
# Format: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/mockforge
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/mockforge

# ===========================================
# JWT Configuration
# ===========================================
# Generate a strong random secret (minimum 32 characters)
# You can use: https://www.random.org/strings/
# Example: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters_long_change_in_production
JWT_EXPIRE=7d

# ===========================================
# Google SMTP Configuration
# ===========================================
# Get from Google Account:
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Other (Custom name)"
# 4. Enter name: "MockForge Backend"
# 5. Copy the 16-character password (remove spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password_without_spaces
SMTP_FROM_NAME=MockForge
SMTP_FROM_EMAIL=noreply@mockforge.com

# ===========================================
# Frontend URL
# ===========================================
# Your deployed frontend URL (Vercel)
# For local development: http://localhost:5173
# For production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ===========================================
# Rate Limiting
# ===========================================
# Prevent API abuse
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# OTP Configuration
# ===========================================
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
